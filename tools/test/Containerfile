# The test image (localhost/disports-test-gl): clickable's image for this
# project (Qt 6, Lomiri, the build dependencies, Xvfb) plus what the tests
# drive and show with. Built by build-image.sh.
ARG BASE
FROM ${BASE}
RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
        xdotool fonts-noto-color-emoji \
        gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-libav gstreamer1.0-tools \
        pulseaudio pulseaudio-utils \
        >/dev/null \
 && rm -rf /var/lib/apt/lists/*
